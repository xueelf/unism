{
  "name": "unism",
  "version": "0.1.0",
  "description": "A lightweight CSS library for consistent, modern styling of native HTML elements across browsers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xueelf/unism.git"
  },
  "license": "MIT",
  "author": "Yuki <admin@yuki.sh>",
  "type": "module",
  "imports": {
    "#/*": "./*"
  },
  "exports": {
    ".": "./dist/index.css",
    "./*.css": "./dist/*.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "format": "prettier \"**/*.{css,html,json,md,ts,tsx,yaml,yml}\" --write --experimental-cli",
    "format:check": "prettier \"**/*.{css,html,json,md,ts,tsx,yaml,yml}\" --check --experimental-cli",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix --cache",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "annal": "^0.2.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "preact": "^10.29.8",
    "prettier": "^3.9.6",
    "prettier-plugin-sort": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "warn"
    }
  }
}
